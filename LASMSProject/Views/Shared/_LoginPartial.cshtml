@using Microsoft.AspNetCore.Identity
@using LASMSProject.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);

        <li class="nav-item">
            @if (User.IsInRole("Admin"))
            {
                <a class="nav-link btn  text-white mx-2" asp-controller="Admin" asp-action="Index">Admin Panel</a>
            }
            else if (User.IsInRole("Manager"))
            {
                <a class="nav-link btn  text-white mx-2" asp-controller="Manager" asp-action="Index">Manager Dashboard</a>
            }
            else if (User.IsInRole("Employee"))
            {
                <a class="nav-link btn btn-outline-light text-white mx-2" asp-controller="Employee" asp-action="Index">Dashboard</a>
                @* <a class="nav-link btn btn-outline-light text-white mx-2" asp-controller="Employee" asp-action="MyPayslips">My Payslips</a> *@
            }
        </li>

        <li class="nav-item">
            <span class="nav-link text-white">Hello, @user?.FirstName!</span>
        </li>

        <li class="nav-item">
            <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link btn btn-link text-white border-0" style="cursor:pointer;">Logout</button>
            </form>
        </li>
    }
    else
    {
        @* <li class="nav-item">
            <a class="nav-link text-white" asp-controller="Account" asp-action="Register">Register</a>
        </li> *@
        <li class="nav-item">
            <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Login</a>
        </li>
    }
</ul>