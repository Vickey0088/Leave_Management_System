@{
    ViewData["Title"] = "Home Page";
}

<!-- HERO SECTION -->
<div class="container mt-4">
    <div class="p-5 text-center bg-dark text-white rounded shadow">
        <h1 class="display-4 fw-bold">Leave Management System</h1>
        <p class="lead mt-3">
            Manage employee leaves efficiently with role-based dashboards for employees, managers, and admins.
        </p>
        <a class="btn btn-light btn-lg mt-3" asp-action="Login" asp-controller="Account">Get Started</a>
    </div>
</div>

<!-- FEATURES SECTION -->
<div class="container mt-5">
    <div class="row text-center">

        <!-- Employee Dashboard -->
        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 h-100">
                <div class="card-body">
                    <i class="fa-solid fa-user fa-3x text-primary"></i>
                    <h4 class="mt-3">Employee Dashboard</h4>
                    <p>Apply for leaves, track status, and manage your personal leave records.</p>
                </div>
            </div>
        </div>

        <!-- Manager Dashboard -->
        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 h-100">
                <div class="card-body">
                    <i class="fa-solid fa-user-tie fa-3x text-success"></i>
                    <h4 class="mt-3">Manager Dashboard</h4>
                    <p>Review, approve, or reject leave requests and monitor team availability.</p>
                </div>
            </div>
        </div>

        <!-- Admin Dashboard -->
        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 h-100">
                <div class="card-body">
                    <i class="fa-solid fa-user-shield fa-3x text-warning"></i>
                    <h4 class="mt-3">Admin Dashboard</h4>
                    <p>Manage users, roles, and system settings with full administrative control.</p>
                </div>
            </div>
        </div>

    </div>
</div>