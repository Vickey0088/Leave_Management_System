@* @model IEnumerable<LASMSProject.Models.MonthlySalary>
@{
    ViewData["Title"] = "My Payslips";
}

<div class="container mt-4">
    <h2>My Salary History</h2>
    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No Generation of any Salary Slips.
        </div>
